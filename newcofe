async def _ble_task():
    global ble_running
    root.after(0,lambda: status_var.set("BLE SCAN..."))
    root.after(0,lambda: _ble_btn_state("scanning"))
    try:
        devices=await BleakScanner.discover(timeout=10.0)
        target=next((d for d in devices if d.name and BLE_NAME in d.name), None)
        if not target:
            found=[f"{d.name or 'Unknown'} | {d.address[-5:]}" for d in devices]
            root.after(0,lambda: messagebox.showerror("BLE",
                f"Khong tim thay '{BLE_NAME}'!\n\n"
                f"Tim thay {len(devices)} thiet bi:\n"+"\n".join(found[:8])+
                "\n\nKiem tra:\n1. ESP32-C3 da nap code BLE chua?\n"
                "2. Bluetooth laptop da bat chua?"))
            root.after(0,lambda: _ble_btn_state("idle")); return

        root.after(0,lambda n=target.name: _ble_btn_state("connecting",n))
        async with BleakClient(target.address) as client:
            print(f"BLE connected: {target.name}")
            root.after(0,lambda n=target.name: status_var.set(f"BLE {n}"))
            root.after(0,lambda: _ble_btn_state("connected"))
            if current_patient: start_session(current_patient[1],current_patient[0])
            await client.start_notify(BLE_CHAR,ble_callback)
            while ble_running: await asyncio.sleep(0.3)
            await client.stop_notify(BLE_CHAR)
    except Exception as e:
        root.after(0,lambda err=str(e): messagebox.showerror("BLE Error",err))
    finally:
        ble_running=False
        root.after(0,lambda: status_var.set("OFFLINE"))
        root.after(0,lambda: conn_mode_var.set("Mode: -"))
        root.after(0,lambda: _ble_btn_state("idle"))
        if len(history)>=5:
            pname=current_patient[1] if current_patient else "Khong ro"
            send_report_email(pname); send_report_via_s3(pname)
            root.after(0, show_report_window)   # ← thêm popup báo cáo
        if current_patient: end_session(current_patient[0]); refresh_hs_combo()

def _ble_thread():
    global ble_loop
    ble_loop=asyncio.new_event_loop(); asyncio.set_event_loop(ble_loop)
    ble_loop.run_until_complete(_ble_task()); ble_loop.close(); ble_loop=None

