def connect_serial():
    global ser,running
    if not current_patient:
        if not messagebox.askyesno("Chua chon benh nhan","Tiep tuc do ma khong luu ho so?"): return
    try:
        ser=serial.Serial(port_var.get(),BAUDRATE,timeout=1)
        running=True; status_var.set("USB LIVE"); conn_mode_var.set("Mode: USB")
        ppg_buffer.clear(); ai_history.clear(); baseline_engine.reset(); alert_engine.reset_all()
        if current_patient: start_session(current_patient[1],current_patient[0])
        threading.Thread(target=_serial_loop,daemon=True).start()
    except Exception as e: messagebox.showerror("Loi ket noi",str(e))

def disconnect_serial():
    global ser,running; running=False
    if ser and ser.is_open: ser.close()
    status_var.set("OFFLINE"); conn_mode_var.set("Mode: -")
    ppg_buffer.clear(); ai_history.clear()
    baseline_engine.reset(); alert_engine.reset_all()
    if len(history)>=5:
        pname=current_patient[1] if current_patient else "Khong ro"
        send_report_email(pname); send_report_via_s3(pname)
        root.after(300, show_report_window)     # ← thêm popup báo cáo
    if current_patient: end_session(current_patient[0]); refresh_hs_combo()

def _serial_loop():
    while running:
        try:
            raw=ser.readline().decode(errors="ignore").strip()
            if raw: process_packet(raw)
        except Exception as e: print("USB ERR:",e)

