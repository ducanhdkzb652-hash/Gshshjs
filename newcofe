    messagebox.showwarning("ALERT",f"Benh nhan: {pname}\n{msg}")
    notify_all(pname,msg,phone); send_alert_email(pname,msg)
    send_alert_via_s3(pname,msg,hr=hr,spo2=spo2,temp=temp)

