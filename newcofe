def process_packet(raw_str):
    global last_temp
    try:
        pkt=json.loads(raw_str)
        if "p" in pkt and len(pkt)==1:
            ppg=float(pkt["p"])
            if ppg>1000: root.after(0,lambda p=ppg: _update_plot(p))
            return
        if "event" in pkt: return
        finger=pkt.get("finger",False); hr=float(pkt.get("hr",0))
        spo2=float(pkt.get("spo2",0)); ppg=float(pkt.get("ppg",0))
        t=float(pkt.get("temp",0))
        if t>25.0 and t<45.0: last_temp=t
        if hr>0 and (hr<20 or hr>250): return
        if spo2>0 and (spo2<50 or spo2>100): return
        if ppg<1000: return
        label,conf=hybrid_predict(ppg,hr,spo2,last_temp)
        root.after(0,lambda p=ppg: _update_plot(p))
        root.after(0,lambda f=finger,h=hr,s=spo2,p=ppg,lb=label,c=conf,t=last_temp:
                    update_gui(f,h,s,p,lb,c,t))
        sig=np.array(ppg_buffer) if len(ppg_buffer)==WINDOW else np.zeros(WINDOW)
        pi=np.std(sig)/(np.mean(sig)+1e-6)*100
        write_row(hr,spo2,last_temp,ppg,pi,label,conf)
        history.append([time.time(),hr,spo2,last_temp,label,conf])
    except Exception as e: print("Packet ERR:",e)

