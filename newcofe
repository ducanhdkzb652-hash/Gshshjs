def show_report_window():
    if len(history) < 5: return
    s = _calc_report_stats()
    if not s['hrs'] or not s['spo2s']: return
    pname = current_patient[1] if current_patient else "Khong ro"

    win = tk.Toplevel(root)
    win.title("Bao Cao Ket Qua Do")
    win.geometry("500x640")
    win.configure(bg=BG)
    win.grab_set()

    # Tiêu đề
    tk.Label(win, text="BAO CAO KET QUA DO",
             font=("Consolas",14,"bold"), bg=BG, fg=ACC).pack(pady=(16,2))
    tk.Label(win, text=f"Mo hinh: {s['model_str']}",
             font=("Consolas",8), bg=BG, fg=PURPLE).pack()
    tk.Frame(win, bg=ACC, height=2).pack(fill="x", padx=20, pady=(6,0))

    info_frame = tk.Frame(win, bg=BG)
    info_frame.pack(fill="x", padx=24, pady=8)

    def row(label, value, color=TEXT):
        r = tk.Frame(info_frame, bg=BG); r.pack(fill="x", pady=2)
        tk.Label(r, text=f"{label:<24}", font=("Consolas",9),
                 bg=BG, fg=GRAY).pack(side="left")
        tk.Label(r, text=value, font=("Consolas",10,"bold"),
                 bg=BG, fg=color).pack(side="left")

    def section(title):
        tk.Frame(info_frame, bg=GRAY, height=1).pack(fill="x", pady=(8,4))
        tk.Label(info_frame, text=title, font=("Consolas",8,"bold"),
                 bg=BG, fg=ACC).pack(anchor="w")

    row("Benh nhan",    pname,                                   ACC)
    row("Thoi luong",   f"{s['duration']//60}p {s['duration']%60}s")
    row("So mau",       str(s['n_total']))

    section("CHI SO LAM SANG")
    row("Nhip tim TB",  f"{s['avg_hr']:.1f} bpm",               ACC)
    row("  Max / Min",  f"{s['max_hr']:.0f} / {s['min_hr']:.0f} bpm")
    row("SpO2 TB",      f"{s['avg_spo2']:.1f}%",                GREEN)
    row("  SpO2 Min",   f"{s['min_spo2']:.1f}%",
        ACC2 if s['min_spo2']<94 else TEXT)
    row("Nhiet do TB",  f"{s['avg_temp']:.1f} °C",              WARN)
    row("Bat thuong LS","CO" if s['clin_high'] else "KHONG",
        ACC2 if s['clin_high'] else GREEN)

    section("DANH GIA AI")
    row("Ty le mau RISK",
        f"{s['rr']:.1f}%  ({s['n_risk']}/{s['n_total']} mau)",
        ACC2 if s['rr']>30 else GREEN)
    row("Conf TB toan phien", f"{s['avg_conf']:.1f}%")
    row("Conf TB mau RISK",
        f"{s['avg_conf_risk']:.1f}%",
        ACC2 if s['avg_conf_risk']>70 else WARN if s['avg_conf_risk']>50 else GREEN)
    row("AI canh bao",  "CO" if s['ai_high'] else "KHONG",
        ACC2 if s['ai_high'] else GREEN)

    # Kết luận
    tk.Frame(info_frame, bg=ACC2 if "CAO" in s['conc'] else GREEN,
             height=2).pack(fill="x", pady=(10,4))
    conc_color = ACC2 if "CAO" in s['conc'] else (WARN if "TRUNG BINH" in s['conc'] else GREEN)
    tk.Label(win, text=f"KET LUAN:  {s['conc']}",
             font=("Consolas",11,"bold"), bg=BG, fg=conc_color).pack(pady=4)

    if "CAO" in s['conc']:
        tk.Label(win, text="⚠  De nghi theo doi va tu van bac si",
                 font=("Consolas",9), bg=BG, fg=WARN).pack()
    elif "TRUNG BINH" in s['conc']:
        tk.Label(win, text="ℹ  Chi so lam sang can theo doi them",
                 font=("Consolas",9), bg=BG, fg=WARN).pack()

    btn_row = tk.Frame(win, bg=BG); btn_row.pack(pady=14)
    tk.Button(btn_row, text="Xuat File .txt", command=export_report,
              bg=CARD, fg=ACC, font=("Consolas",9,"bold"),
              relief="flat", padx=12, pady=4, cursor="hand2").pack(side="left", padx=8)
    tk.Button(btn_row, text="Dong", command=win.destroy,
              bg=CARD, fg=GRAY, font=("Consolas",9,"bold"),
              relief="flat", padx=12, pady=4, cursor="hand2").pack(side="left", padx=8)

