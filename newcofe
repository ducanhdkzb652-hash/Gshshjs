def _calc_report_stats():
    """Tính toàn bộ chỉ số từ history, kết luận ưu tiên AI."""
    hrs   = [h[1] for h in history if h[1]>0]
    spo2s = [h[2] for h in history if h[2]>0]
    temps = [h[3] for h in history if h[3]>0]
    confs = [h[5] for h in history]                        # confidence 0-100
    risk_samples  = [h for h in history if h[4]=="RISK"]
    risk_confs    = [h[5] for h in risk_samples]

    rr           = len(risk_samples)/len(history)*100 if history else 0
    avg_conf      = sum(confs)/len(confs) if confs else 0
    avg_conf_risk = sum(risk_confs)/len(risk_confs) if risk_confs else 0
    avg_hr    = sum(hrs)/len(hrs)       if hrs   else 0
    avg_spo2  = sum(spo2s)/len(spo2s)  if spo2s else 0
    avg_temp  = sum(temps)/len(temps)  if temps  else 0
    min_spo2  = min(spo2s) if spo2s else 0
    max_hr    = max(hrs)   if hrs   else 0
    min_hr    = min(hrs)   if hrs   else 0

    # Kết luận: ưu tiên AI score, clinical chỉ là hỗ trợ
    ai_high   = rr > 30 or avg_conf_risk > 70
    clin_high = avg_spo2 < 94 or avg_temp >= 38.3
    if ai_high and clin_high:
        conc = "NGUY CO CAO (AI + Lam sang)"
    elif ai_high:
        conc = "NGUY CO CAO (AI)"
    elif clin_high:
        conc = "NGUY CO TRUNG BINH (Lam sang)"
    else:
        conc = "NGUY CO THAP"

    model_info = []
    if dl_model:  model_info.append("CNN-BiLSTM")
    if xgb_model: model_info.append("XGBoost")
    model_str = " + ".join(model_info) if model_info else "Rule-based (no model)"

    duration = int(history[-1][0]-history[0][0]) if len(history)>1 else 0

    return dict(
        hrs=hrs, spo2s=spo2s, temps=temps,
        rr=rr, avg_conf=avg_conf, avg_conf_risk=avg_conf_risk,
        avg_hr=avg_hr, avg_spo2=avg_spo2, avg_temp=avg_temp,
        min_spo2=min_spo2, max_hr=max_hr, min_hr=min_hr,
        n_risk=len(risk_samples), n_total=len(history),
        conc=conc, model_str=model_str, duration=duration,
        ai_high=ai_high, clin_high=clin_high,
    )

# ================================================================
#  EXPORT REPORT (lưu file .txt)
# ================================================================
def export_report():
    if len(history)<10: messagebox.showwarning("","Can it nhat 10 mau"); return
    s = _calc_report_stats()
    pinfo = (f"ID:{current_patient[0]} | {current_patient[1]}" if current_patient else "Khong co ho so")
    report = (
        f"AI SEPSIS - BAO CAO\n{'='*40}\n"
        f"Ngay      : {datetime.now().strftime('%d/%m/%Y %H:%M')}\n"
        f"Benh nhan : {pinfo}\n"
        f"Ket noi   : {conn_mode_var.get()}\n"
        f"Mo hinh AI: {s['model_str']}\n"
        f"So mau    : {s['n_total']} | Thoi luong: {s['duration']//60}p{s['duration']%60}s\n"
        f"\n--- CHI SO LAM SANG ---\n"
        f"HR    : {s['avg_hr']:.1f} bpm  (Max:{s['max_hr']:.0f}  Min:{s['min_hr']:.0f})\n"
        f"SpO2  : {s['avg_spo2']:.1f}%   (Min:{s['min_spo2']:.1f}%)\n"
        f"Nhiet : {s['avg_temp']:.1f} C\n"
        f"\n--- DANH GIA AI ---\n"
        f"Ty le mau RISK      : {s['rr']:.1f}%  ({s['n_risk']}/{s['n_total']} mau)\n"
        f"Conf TB toan phien  : {s['avg_conf']:.1f}%\n"
        f"Conf TB mau RISK    : {s['avg_conf_risk']:.1f}%\n"
        f"AI canh bao         : {'CO' if s['ai_high'] else 'KHONG'}\n"
        f"Lam sang bat thuong : {'CO' if s['clin_high'] else 'KHONG'}\n"
        f"\n{'='*40}\n"
        f"KET LUAN: {s['conc']}\n"
        f"Cap cuu : 115\n"
    )
    folder = DATA_DIR
    if current_patient:
        safe = "".join(c for c in current_patient[1] if c.isalnum() or c in " _-")
        folder = DATA_DIR/f"P{current_patient[0]:04d}_{safe}"; folder.mkdir(exist_ok=True)
    path = folder/f"BaoCao_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    with open(path,"w",encoding="utf-8-sig") as f: f.write(report)
    messagebox.showinfo("OK",f"Da luu: {path}")

