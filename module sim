#include <WiFi.h>
#include <WebServer.h>
#include <ArduinoJson.h>
#include <HardwareSerial.h>

// ════════════════════════════════════════════════
//  CẤU HÌNH — SỬA TRƯỚC KHI NẠP
// ════════════════════════════════════════════════
#define WIFI_SSID      "Ten_WiFi_cua_ban"
#define WIFI_PASS      "Mat_khau_WiFi"
#define DEFAULT_PHONE  "0901234567"

// A7680C UART
#define SIM_RX    20
#define SIM_TX    21
#define SIM_BAUD  115200

// ════════════════════════════════════════════════
//  OBJECTS
// ════════════════════════════════════════════════
WebServer      server(80);
HardwareSerial simSerial(1);
bool simOK = false;

// ════════════════════════════════════════════════
//  AT COMMAND
// ════════════════════════════════════════════════
String simAT(const char* cmd, uint32_t timeout = 2000) {
  simSerial.println(cmd);
  String resp = "";
  unsigned long t = millis();
  while (millis() - t < timeout) {
    while (simSerial.available())
      resp += (char)simSerial.read();
    if (resp.indexOf("OK")    > -1 ||
        resp.indexOf("ERROR") > -1) break;
  }
  Serial.println("SIM << " + resp);
  return resp;
}

// ════════════════════════════════════════════════
//  KHỞI ĐỘNG SIM
// ════════════════════════════════════════════════
bool simInit() {
  Serial.println("Khoi dong A7680C...");
  delay(3000);
  for (int i = 0; i < 5; i++) {
    if (simAT("AT").indexOf("OK") > -1) {
      simAT("ATE0");
      simAT("AT+CMGF=1");
      simAT("AT+CSCS=\"GSM\"");
      Serial.println("A7680C OK!");
      return true;
    }
    delay(1000);
  }
  Serial.println("A7680C FAIL!");
  return false;
}

// ════════════════════════════════════════════════
//  GỬI SMS
// ════════════════════════════════════════════════
bool sendSMS(String phone, String msg) {
  if (!simOK) {
    Serial.println("SIM chua san sang");
    return false;
  }

  // Chuẩn hoá số điện thoại
  if (phone.startsWith("84")) phone = "0" + phone.substring(2);
  if (!phone.startsWith("0")) phone = "0" + phone;

  Serial.println("Gui SMS den: " + phone);
  Serial.println("Noi dung: " + msg);

  simAT("AT+CMGF=1");
  simSerial.println("AT+CMGS=\"" + phone + "\"");
  delay(500);
  simSerial.print(msg);
  simSerial.write(26);   // Ctrl+Z = gửi
  delay(4000);
  Serial.println("SMS da gui!");
  return true;
}

// ════════════════════════════════════════════════
//  WEB ROUTES
// ════════════════════════════════════════════════

// GET / — trang kiểm tra
void handleRoot() {
  String html = "<!DOCTYPE html><html><head><meta charset='UTF-8'>";
  html += "<title>SepsisAI SMS Gateway</title>";
  html += "<style>body{font-family:monospace;background:#080c14;color:#00e5ff;padding:20px}";
  html += "h2{color:#00ff9f}.ok{color:#00ff9f}.fail{color:#ff4d6d}</style></head><body>";
  html += "<h2>SepsisAI SMS Gateway</h2>";
  html += "<p>SIM: <span class='" + String(simOK?"ok":"fail") + "'>" + String(simOK?"OK":"FAIL") + "</span></p>";
  html += "<p>IP: " + WiFi.localIP().toString() + "</p>";
  html += "<hr><p><b>Endpoints:</b></p>";
  html += "<p>POST /sms &nbsp;&nbsp;→ gui SMS tuy chinh</p>";
  html += "<p>POST /alert &nbsp;→ canh bao nguy co</p>";
  html += "<p>POST /report → bao cao sau lan do</p>";
  html += "<p>GET  /status → kiem tra SIM</p>";
  html += "</body></html>";
  server.send(200, "text/html", html);
}

// POST /sms
// {"phone":"0901234567","message":"noi dung"}
void handleSMS() {
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}");
    return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}");
    return;
  }
  String phone = doc["phone"]   | DEFAULT_PHONE;
  String msg   = doc["message"] | "SepsisAI SMS";
  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"sent\"}" : "{\"status\":\"failed\"}");
}

// POST /alert
// {"phone":"...","patient":"Ten BN","alert":"noi dung","hr":130,"spo2":86,"temp":38.9}
void handleAlert() {
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}");
    return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}");
    return;
  }
  String phone   = doc["phone"]   | DEFAULT_PHONE;
  String patient = doc["patient"] | "Benh nhan";
  String alert   = doc["alert"]   | "Nguy co cao";
  int    hr      = doc["hr"]      | 0;
  int    spo2    = doc["spo2"]    | 0;
  float  temp    = doc["temp"]    | 0.0f;

  String msg = "CANH BAO SEPSIS AI\n";
  msg += "BN: "    + patient + "\n";
  msg += alert     + "\n";
  if (hr   > 0) msg += "HR: "   + String(hr)        + " bpm\n";
  if (spo2 > 0) msg += "SpO2: " + String(spo2)      + "%\n";
  if (temp > 0) msg += "Nhiet: "+ String(temp, 1)   + "C\n";
  msg += "Kiem tra ngay!";

  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"alert_sent\"}" : "{\"status\":\"failed\"}");
}

// POST /report
// {"phone":"...","patient":"...","hr":72,"spo2":98,"temp":36.5,
//  "risk_rate":5.2,"conclusion":"NGUY CO THAP","samples":120}
void handleReport() {
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}");
    return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}");
    return;
  }
  String phone      = doc["phone"]      | DEFAULT_PHONE;
  String patient    = doc["patient"]    | "Benh nhan";
  float  hr         = doc["hr"]         | 0.0f;
  float  spo2       = doc["spo2"]       | 0.0f;
  float  temp       = doc["temp"]       | 0.0f;
  float  risk_rate  = doc["risk_rate"]  | 0.0f;
  String conclusion = doc["conclusion"] | "UNKNOWN";
  int    samples    = doc["samples"]    | 0;

  String msg = "BAO CAO DO LUONG\n";
  msg += "BN: "      + patient              + "\n";
  msg += "Mau: "     + String(samples)      + "\n";
  msg += "HR: "      + String(hr,   1)      + " bpm\n";
  msg += "SpO2: "    + String(spo2, 1)      + "%\n";
  msg += "Nhiet: "   + String(temp, 1)      + "C\n";
  msg += "Nguy co: " + String(risk_rate, 1) + "%\n";
  msg += "=> "       + conclusion;

  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"report_sent\"}" : "{\"status\":\"failed\"}");
}

// GET /status — kiểm tra SIM
void handleStatus() {
  String net  = simAT("AT+CREG?", 1000);
  String csq  = simAT("AT+CSQ",   1000);
  bool   conn = (net.indexOf(",1") > -1 || net.indexOf(",5") > -1);
  String json = "{";
  json += "\"sim_ok\":"  + String(simOK ? "true" : "false") + ",";
  json += "\"network_ok\":" + String(conn ? "true" : "false") + ",";
  json += "\"signal\":\"" + csq.substring(0, min((int)csq.length(), 20)) + "\"";
  json += "}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  server.send(404, "application/json", "{\"error\":\"Not found\"}");
}

// ════════════════════════════════════════════════
//  SETUP
// ════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("=== SepsisAI SMS Gateway ===");
  Serial.println("Ket noi WiFi: " + String(WIFI_SSID));

  WiFi.begin(WIFI_SSID, WIFI_PASS);
  int retry = 0;
  while (WiFi.status() != WL_CONNECTED && retry < 30) {
    delay(500);
    Serial.print(".");
    retry++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi OK!");
    Serial.println(">>> IP: " + WiFi.localIP().toString() + " <<<");
    Serial.println(">>> Dien IP nay vao Python: ESP32_S3_IP = \"" +
                   WiFi.localIP().toString() + "\" <<<");
  } else {
    Serial.println("\nWiFi FAIL! Kiem tra SSID/Pass");
  }

  // A7680C
  simSerial.begin(SIM_BAUD, SERIAL_8N1, SIM_RX, SIM_TX);
  simOK = simInit();

  // Routes
  server.on("/",        HTTP_GET,  handleRoot);
  server.on("/sms",     HTTP_POST, handleSMS);
  server.on("/alert",   HTTP_POST, handleAlert);
  server.on("/report",  HTTP_POST, handleReport);
  server.on("/status",  HTTP_GET,  handleStatus);
  server.onNotFound(handleNotFound);
  server.begin();

  Serial.println("Web server OK — port 80");
  Serial.println("San sang nhan lenh tu Python!");
}

// ════════════════════════════════════════════════
//  LOOP
// ════════════════════════════════════════════════
void loop() {
  server.handleClient();

  // Tự động reconnect WiFi nếu mất kết nối
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi mat ket noi, thu lai...");
    WiFi.reconnect();
    delay(5000);
  }
}
