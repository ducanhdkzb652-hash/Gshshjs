// POST /wifi (không cần key)
void handleWiFiConfig() {
  String ssid = "", pass = "";
  if (server.hasArg("plain")) {
    StaticJsonDocument<256> doc;
    if (!deserializeJson(doc, server.arg("plain"))) {
      ssid = doc["ssid"] | ""; pass = doc["pass"] | "";
    }
  }
  if (ssid.isEmpty() && server.hasArg("ssid")) {
    ssid = server.arg("ssid"); pass = server.arg("pass");
  }
  if (ssid.isEmpty()) {
    server.send(400, "application/json", "{\"error\":\"Thieu SSID\"}"); return;
  }
  saveWiFiCreds(ssid, pass);
  if (server.hasArg("ssid")) {
    server.send(200, "text/html",
      "<html><body style='font-family:monospace;background:#080c14;"
      "color:#00ff9f;padding:20px'><h2>Da luu!</h2>"
      "<p>Dang ket noi: <b>" + ssid + "</b></p>"
      "<p>Khoi dong lai sau 3 giay...</p></body></html>");
  } else {
    server.send(200, "application/json",
      "{\"status\":\"saved\",\"ssid\":\"" + ssid + "\"}");
  }
  delay(500); ESP.restart();
}

// POST /sms
void handleSMS() {
  if (!checkAPIKey()) return;
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}"); return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}"); return;
  }
  String phone = doc["phone"]   | DEFAULT_PHONE;
  String msg   = doc["message"] | "SepsisAI SMS";
  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"sent\"}" : "{\"status\":\"failed\"}");
}

// POST /alert
void handleAlert() {
  if (!checkAPIKey()) return;
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}"); return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}"); return;
  }
  String phone   = doc["phone"]   | DEFAULT_PHONE;
  String patient = doc["patient"] | "Benh nhan";
  String alert_  = doc["alert"]   | "Nguy co cao";
  int    hr      = doc["hr"]      | 0;
  int    spo2    = doc["spo2"]    | 0;
  float  temp    = doc["temp"]    | 0.0f;

  String msg = "CANH BAO SEPSIS AI\n";
  msg += "BN: " + patient + "\n" + alert_ + "\n";
  if (hr   > 0) msg += "HR: "    + String(hr)     + " bpm\n";
  if (spo2 > 0) msg += "SpO2: "  + String(spo2)   + "%\n";
  if (temp > 0) msg += "Nhiet: " + String(temp,1) + "C\n";
  msg += "Kiem tra ngay!";

  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"alert_sent\"}" : "{\"status\":\"failed\"}");
}

// POST /report
void handleReport() {
  if (!checkAPIKey()) return;
  if (!server.hasArg("plain")) {
    server.send(400, "application/json", "{\"error\":\"No body\"}"); return;
  }
  StaticJsonDocument<512> doc;
  if (deserializeJson(doc, server.arg("plain"))) {
    server.send(400, "application/json", "{\"error\":\"Bad JSON\"}"); return;
  }
  String phone      = doc["phone"]      | DEFAULT_PHONE;
  String patient    = doc["patient"]    | "Benh nhan";
  float  hr         = doc["hr"]         | 0.0f;
  float  spo2       = doc["spo2"]       | 0.0f;
  float  temp       = doc["temp"]       | 0.0f;
  float  risk_rate  = doc["risk_rate"]  | 0.0f;
  String conclusion = doc["conclusion"] | "UNKNOWN";
  int    samples    = doc["samples"]    | 0;

  String msg = "BAO CAO DO LUONG\n";
  msg += "BN: "      + patient              + "\n";
  msg += "Mau: "     + String(samples)      + "\n";
  msg += "HR: "      + String(hr,   1)      + " bpm\n";
  msg += "SpO2: "    + String(spo2, 1)      + "%\n";
  msg += "Nhiet: "   + String(temp, 1)      + "C\n";
  msg += "Nguy co: " + String(risk_rate, 1) + "%\n";
  msg += "=> "       + conclusion;

  bool ok = sendSMS(phone, msg);
  server.send(200, "application/json",
    ok ? "{\"status\":\"report_sent\"}" : "{\"status\":\"failed\"}");
}

// GET /status
void handleStatus() {
  if (!checkAPIKey()) return;
  String net  = simAT("AT+CREG?", 1000);
  String csq  = simAT("AT+CSQ",   1000);
  bool   conn = (net.indexOf(",1")!=-1 || net.indexOf(",5")!=-1);
  String ip   = staMode ? WiFi.localIP().toString() : WiFi.softAPIP().toString();
  String json = "{";
  json += "\"sim_ok\":"      + String(simOK?"true":"false")  + ",";
  json += "\"network_ok\":"  + String(conn?"true":"false")   + ",";
  json += "\"wifi_mode\":\""  + String(staMode?"STA":"AP")   + "\",";
  json += "\"ip\":\""         + ip                           + "\",";
  json += "\"wifi_ssid\":\""  + savedSSID                    + "\",";
  json += "\"signal\":\""     + csq.substring(0,20)          + "\"";
  json += "}";
  server.send(200, "application/json", json);
}

// POST /reset_sim
void handleResetSIM() {
  if (!checkAPIKey()) return;
  simHardReset(); simOK = simInit();
  server.send(200, "application/json",
    simOK ? "{\"status\":\"sim_ok\"}" : "{\"status\":\"sim_fail\"}");
}

void handleNotFound() {
  server.send(404, "application/json", "{\"error\":\"Not found\"}");
}

// ════════════════════════════════════════════════
//  SETUP
// ════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("=== SepsisAI SMS Gateway ===");

  pinMode(SIM_RST, OUTPUT);
  digitalWrite(SIM_RST, HIGH);

  loadWiFiCreds();

  if (savedSSID.length() > 0) {
    if (!connectWiFiSTA(savedSSID, savedPASS)) startAPMode();
  } else {
    startAPMode();
  }

  simSerial.begin(SIM_BAUD, SERIAL_8N1, SIM_RX, SIM_TX);
  simOK = simInit();

  // Khai báo header X-API-Key để WebServer có thể đọc
  const char* headers[] = {"X-API-Key"};
  server.collectHeaders(headers, 1);

  server.on("/",          HTTP_GET,  handleRoot);
  server.on("/wifi",      HTTP_POST, handleWiFiConfig);
  server.on("/sms",       HTTP_POST, handleSMS);
  server.on("/alert",     HTTP_POST, handleAlert);
  server.on("/report",    HTTP_POST, handleReport);
  server.on("/status",    HTTP_GET,  handleStatus);
  server.on("/reset_sim", HTTP_POST, handleResetSIM);
  server.onNotFound(handleNotFound);
  server.begin();

  Serial.println("Web server OK — port 80");
  Serial.println("API Key: " + String(API_KEY));
  if (staMode)
    Serial.println(">>> ESP32_S3_IP = \"" + WiFi.localIP().toString() + "\" <<<");
  else
    Serial.println(">>> AP: " + String(AP_SSID) + " / 192.168.4.1 <<<");
  Serial.println("San sang!");
}

// ════════════════════════════════════════════════
//  LOOP
// ════════════════════════════════════════════════
void loop() {
  server.handleClient();

  // Forward Serial ↔ A7680C (debug AT command)
  while (Serial.available())    simSerial.write(Serial.read());
  while (simSerial.available()) Serial.write(simSerial.read());

  if (staMode && WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi mat ket noi, thu lai...");
    WiFi.reconnect(); delay(5000);
  }
}
