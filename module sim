// ════════════════════════════════════════════════
//  API KEY — đổi thành chuỗi bí mật của bạn
//  Python phải gửi header: X-API-Key: <key này>
// ════════════════════════════════════════════════
#define API_KEY  "SepsisAI_S3_2024_XK9!"

// ════════════════════════════════════════════════
//  PIN
// ════════════════════════════════════════════════
#define SIM_RX    16
#define SIM_TX    17
#define SIM_RST   4
#define SIM_BAUD  115200
#define DEFAULT_PHONE  "0899145316"

#define AP_SSID  "UBND123"
#define AP_PASS  "12345678"

// ════════════════════════════════════════════════
//  OBJECTS
// ════════════════════════════════════════════════
WebServer      server(80);
HardwareSerial simSerial(1);
Preferences    prefs;

bool simOK   = false;
bool staMode = false;

String savedSSID = "";
String savedPASS = "";

// ════════════════════════════════════════════════
//  KIỂM TRA API KEY
//  Mọi request đều phải qua hàm này trước
// ════════════════════════════════════════════════
bool checkAPIKey() {
  // Cho phép truy cập trang / và /wifi không cần key
  // (để cấu hình lần đầu từ trình duyệt)
  String path = server.uri();
  if (path == "/" || path == "/wifi") return true;

  // Các endpoint còn lại phải có key
  if (!server.hasHeader("X-API-Key")) {
    Serial.println("BLOCKED: Thieu API Key - " + server.client().remoteIP().toString());
    server.send(401, "application/json",
      "{\"error\":\"Thieu X-API-Key header\"}");
    return false;
  }

  String key = server.header("X-API-Key");
  if (key != API_KEY) {
    Serial.println("BLOCKED: Sai API Key tu " +
                   server.client().remoteIP().toString() +
                   " key=" + key);
    server.send(403, "application/json",
      "{\"error\":\"API Key sai\"}");
    return false;
  }

  return true;  // key đúng
}

// ════════════════════════════════════════════════
//  WiFi FLASH
// ════════════════════════════════════════════════
void loadWiFiCreds() {
  prefs.begin("wifi", true);
  savedSSID = prefs.getString("ssid", "");
  savedPASS = prefs.getString("pass", "");
  prefs.end();
  Serial.println("WiFi da luu: " + savedSSID);
}

void saveWiFiCreds(String ssid, String pass) {
  prefs.begin("wifi", false);
  prefs.putString("ssid", ssid);
  prefs.putString("pass", pass);
  prefs.end();
  savedSSID = ssid; savedPASS = pass;
  Serial.println("Da luu WiFi: " + ssid);
}

// ════════════════════════════════════════════════
//  WiFi STA / AP
// ════════════════════════════════════════════════
bool connectWiFiSTA(String ssid, String pass) {
  Serial.println("Ket noi WiFi: " + ssid);
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid.c_str(), pass.c_str());
  int retry = 0;
  while (WiFi.status() != WL_CONNECTED && retry < 20) {
    delay(500); Serial.print("."); retry++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi OK! IP: " + WiFi.localIP().toString());
    Serial.println(">>> ESP32_S3_IP = \"" +
                   WiFi.localIP().toString() + "\" <<<");
    staMode = true; return true;
  }
  Serial.println("\nWiFi FAIL!"); staMode = false; return false;
}

void startAPMode() {
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  Serial.println("AP Mode: " + String(AP_SSID));
  Serial.println("IP: " + WiFi.softAPIP().toString());
  staMode = false;
}

// ════════════════════════════════════════════════
//  AT COMMAND
// ════════════════════════════════════════════════
String simAT(const String& cmd, uint32_t timeout = 3000) {
  simSerial.println(cmd);
  Serial.print(">>> "); Serial.println(cmd);
  String resp = "";
  uint32_t t = millis();
  while (millis()-t < timeout) {
    while (simSerial.available())
      resp += (char)simSerial.read();
    if (resp.indexOf("OK")    != -1 ||
        resp.indexOf("ERROR") != -1) break;
  }
  Serial.print("<<< "); Serial.println(resp);
  return resp;
}

// ════════════════════════════════════════════════
//  RESET SIM
// ════════════════════════════════════════════════
void simHardReset() {
  Serial.println("Hard reset A7680C...");
  digitalWrite(SIM_RST, LOW);  delay(500);
  digitalWrite(SIM_RST, HIGH); delay(8000);
  Serial.println("Module san sang!");
}

bool simCheckReady() {
  if (simAT("AT").indexOf("OK") == -1) return false;
  if (simAT("AT+CPIN?").indexOf("READY") == -1) return false;
  simAT("AT+CSQ");
  String reg = simAT("AT+CREG?");
  return (reg.indexOf(",1") != -1 || reg.indexOf(",5") != -1);
}

bool simInit() {
  Serial.println("Khoi dong A7680C...");
  if (simCheckReady()) {
    simAT("AT+CMGF=1"); simAT("AT+CSCS=\"GSM\"");
    Serial.println("A7680C OK!"); return true;
  }
  simHardReset();
  if (simCheckReady()) {
    simAT("AT+CMGF=1"); simAT("AT+CSCS=\"GSM\"");
    Serial.println("A7680C OK sau reset!"); return true;
  }
  Serial.println("A7680C FAIL!"); return false;
}

// ════════════════════════════════════════════════
//  GỬI SMS — giống code hoạt động
// ════════════════════════════════════════════════
bool sendSMS(String phone, String msg) {
  if (!simOK) {
    Serial.println("SIM chua san sang"); return false;
  }
  if (phone.startsWith("84")) phone = "0" + phone.substring(2);
  if (!phone.startsWith("0")) phone = "0" + phone;
  Serial.println("Gui SMS den: " + phone);

  simAT("AT+CMGF=1", 1000);
  simAT("AT+CSCS=\"GSM\"", 1000);

  simSerial.println("AT+CMGS=\"" + phone + "\"");
  Serial.println(">>> AT+CMGS=\"" + phone + "\"");
  delay(1500);

  // Chờ dấu ">"
  String prompt = "";
  uint32_t t = millis();
  while (millis()-t < 3000) {
    while (simSerial.available())
      prompt += (char)simSerial.read();
    if (prompt.indexOf(">") != -1) break;
  }
  if (prompt.indexOf(">") == -1) {
    Serial.println("Khong nhan duoc '>'!"); return false;
  }

  simSerial.print(msg);
  delay(500);
  simSerial.write(26);  // Ctrl+Z

  // Chờ +CMGS: tối đa 15s
  String result = "";
  t = millis();
  while (millis()-t < 15000) {
    while (simSerial.available())
      result += (char)simSerial.read();
    if (result.indexOf("+CMGS:") != -1) break;
    if (result.indexOf("ERROR")  != -1) break;
  }
  Serial.println("<<< " + result);

  if (result.indexOf("+CMGS:") != -1) {
    Serial.println("SMS OK!"); return true;
  }
  Serial.println("SMS FAIL!"); return false;
}

