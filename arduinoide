// ════════════════════════════════════════════════
//  VẼ SÓNG PPG
// ════════════════════════════════════════════════
void drawWave() {
  if (!fingerDetected) return;
  int16_t wMin = waveBuffer[0], wMax = waveBuffer[0];
  for (int i = 1; i < WAVE_LEN; i++) {
    wMin = min(wMin, waveBuffer[i]);
    wMax = max(wMax, waveBuffer[i]);
  }
  if (wMax == wMin) wMax = wMin + 1;
  for (int i = 1; i < WAVE_LEN; i++) {
    int xi = map(i,     0, WAVE_LEN-1, WAVE_X, WAVE_X+WAVE_W-1);
    int xp = map(i - 1, 0, WAVE_LEN-1, WAVE_X, WAVE_X+WAVE_W-1);
    int yi = map(waveBuffer[(waveIdx+i)   % WAVE_LEN],
                 wMin, wMax, WAVE_Y+WAVE_H-2, WAVE_Y+2);
    int yp = map(waveBuffer[(waveIdx+i-1) % WAVE_LEN],
                 wMin, wMax, WAVE_Y+WAVE_H-2, WAVE_Y+2);
    if (waveInited)
      tft.drawLine(xp, prevWY[i-1], xi, prevWY[i], C_BG);
    tft.drawLine(xp, yp, xi, yi, C_WAVE);
    prevWY[i-1] = yp; prevWY[i] = yi;
  }
  waveInited = true;
}

// ════════════════════════════════════════════════
//  SENSOR HELPERS
// ════════════════════════════════════════════════
bool detectFinger(uint32_t ir) {
  if (ir > IR_FINGER_THRESHOLD) {
    if (++goodCount >= FINGER_CONFIRM_COUNT) return true;
  } else { goodCount = 0; }
  return false;
}

void fillBuffer() {
  for (byte i = 0; i < 100; i++) {
    while (!sensor.available()) sensor.check();
    redBuffer[i] = sensor.getRed();
    irBuffer[i]  = sensor.getIR();
    sensor.nextSample();
  }
  maxim_heart_rate_and_oxygen_saturation(
    irBuffer, 100, redBuffer,
    &spo2, &validSPO2, &heartRate_mx, &validHR_mx);
}
void readTemp() {
  if (!mlxOK || !tempMeasuring) return;   // ← thêm !tempMeasuring
  float obj = mlx.readObjectTempC();
  // ... phần còn lại giữ nguyên

  float amb = mlx.readAmbientTempC();
  Serial.printf("[TEMP] obj=%.2f  amb=%.2f\n", obj, amb);
  if (isnan(obj) || isinf(obj)) return;
  if (obj >= 20.0f && obj <= 42.0f)
    tempC = tempC * 0.7f + obj * 0.3f;
  else if (!isnan(amb) && !isinf(amb) && amb >= 20.0f && amb <= 42.0f) {
    tempC = tempC * 0.7f + amb * 0.3f;
    Serial.println("[TEMP] fallback ambient");
  }
}

// ════════════════════════════════════════════════
//  SETUP
// ════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(2000);   // chờ USB CDC
  Serial.println("=== BOOT ===");

  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  fspi.begin(TFT_SCK, -1, TFT_MOSI, TFT_CS);
  tft.begin(10000000);
  tft.setRotation(1);

  tft.fillScreen(ILI9341_RED);   delay(150);
  tft.fillScreen(ILI9341_GREEN); delay(150);
  tft.fillScreen(ILI9341_BLUE);  delay(150);
  tft.fillScreen(C_BG);

  tft.setTextColor(C_HEADER); tft.setTextSize(3);
  tft.setCursor(40, 40);  tft.print("SepsisAI");
  tft.setTextColor(C_WHITE); tft.setTextSize(1);
  tft.setCursor(55, 85);  tft.print("AI Sepsis Monitor v3");
  tft.setCursor(70, 100); tft.print("ESP32-C3 Mini + BLE");
  tft.setTextColor(C_GRAY);
  tft.setCursor(60, 120); tft.print("Khoi dong...");
  pinMode(BTN_TEMP_PIN, INPUT_PULLUP);

  // I2C — 100kHz bắt buộc cho MLX90614
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  // ── GY-906 ────────────────────────────────────
  Serial.println("[INIT] GY-906...");
  delay(500);
  if (!mlx.begin()) {
    Serial.println("[INIT] GY-906: FAIL");
    tft.setTextColor(C_YELLOW);
    tft.setCursor(55, 136); tft.print("GY-906: KHONG TIM THAY");
    mlxOK = false;
  } else {
    mlxOK = true;
    Serial.println("[INIT] GY-906: OK");
    tempC = 36.0f;
    for (int i = 0; i < 10; i++) {
      float obj = mlx.readObjectTempC();
      float amb = mlx.readAmbientTempC();
      Serial.printf("[INIT] attempt %d: obj=%.2f amb=%.2f\n", i, obj, amb);
      if (!isnan(obj) && !isinf(obj) && obj >= 20.0f && obj <= 42.0f) {
        tempC = obj; break;
      } else if (!isnan(amb) && !isinf(amb) && amb >= 20.0f && amb <= 42.0f) {
        tempC = amb; break;
      }
      delay(200);
    }
    tft.setTextColor(C_GREEN);
    tft.setCursor(55, 136);
    tft.print("GY-906: OK  "); tft.print(tempC, 1); tft.print("C");
  }

  // ── MAX30102 ──────────────────────────────────
  Serial.println("[INIT] MAX30102...");
  if (!sensor.begin(Wire, I2C_SPEED_STANDARD)) {
    Serial.println("[INIT] MAX30102: FAIL");
    tft.setTextColor(C_RED);
    tft.setCursor(55, 152); tft.print("MAX30102: LOI!");
    while (1) delay(1000);
  }
  Serial.println("[INIT] MAX30102: OK");
  tft.setTextColor(C_GREEN);
  tft.setCursor(55, 152); tft.print("MAX30102: OK");

  // FIX: LED 0x1F + ADC 4096 → SpO2 chính xác
  sensor.setup(0x1F, 4, 2, 400, 411, 4096);
  sensor.setPulseAmplitudeRed(0x1F);
  sensor.setPulseAmplitudeIR(0x1F);
  sensor.setPulseAmplitudeGreen(0);
  delay(400);

  // ── BLE ───────────────────────────────────────
  tft.setTextColor(C_GRAY);
  tft.setCursor(55, 168); tft.print("BLE: Khoi dong...");
  setupBLE();
  tft.fillRect(55, 168, 265, 10, C_BG);
  tft.setTextColor(C_PURPLE);
  tft.setCursor(55, 168);
  tft.print("BLE: "); tft.print(BLE_DEVICE_NAME);
  tft.print(" | UUID sẵn sàng");
  delay(600);

  Serial.println("{\"status\":\"ESP_READY\"}");
  Serial.println("{\"ble_name\":\"" + String(BLE_DEVICE_NAME) + "\"}");
  Serial.println("{\"ble_service\":\"" + String(BLE_SERVICE_UUID) + "\"}");
  Serial.println("{\"ble_char\":\"" + String(BLE_CHAR_UUID) + "\"}");

  drawLayout();
  memset(waveBuffer, 0, sizeof(waveBuffer));
  memset(prevWY,     0, sizeof(prevWY));
  fillBuffer();
}

// ════════════════════════════════════════════════
//  LOOP
// ════════════════════════════════════════════════
void loop() {
  static uint32_t lastReport = 0;
  static uint32_t lastDraw   = 0;
  static uint32_t lastTemp   = 0;
// ── Nút toggle GY-906 (debounce 200ms) ──────────
static bool     btnLast     = HIGH;
static uint32_t btnDebounce = 0;
bool btnNow = digitalRead(BTN_TEMP_PIN);
if (btnNow == LOW && btnLast == HIGH &&
    millis() - btnDebounce > 200) {
  btnDebounce   = millis();
  tempMeasuring = !tempMeasuring;
  Serial.printf("{\"temp_mode\":\"%s\"}\n",
                tempMeasuring ? "LIVE" : "HOLD");
}
btnLast = btnNow;
  // ── Đọc nhiệt độ 2s ──────────────────────────
  if (millis() - lastTemp >= 2000) {
    lastTemp = millis();
    readTemp();
  }

  // ── Slide buffer ─────────────────────────────
  for (byte i = 25; i < 100; i++) {
    redBuffer[i-25] = redBuffer[i];
    irBuffer[i-25]  = irBuffer[i];
  }

  // ── Đọc 25 mẫu + gửi PPG nhanh ──────────────
  for (byte i = 75; i < 100; i++) {
    while (!sensor.available()) sensor.check();
    uint32_t rawIR  = sensor.getIR();
    uint32_t rawRed = sensor.getRed();
    sensor.nextSample();

    redBuffer[i]        = rawRed;
    irBuffer[i]         = rawIR;
    lastRawIR           = rawIR;
    fingerDetected      = detectFinger(rawIR);
    waveBuffer[waveIdx] = (int16_t)(rawIR >> 8);
    waveIdx             = (waveIdx + 1) % WAVE_LEN;

    // Gửi PPG nhanh ~25/s qua cả Serial và BLE
    ppgCount++;
    if (ppgCount >= 3) {
      ppgCount = 0;
      if (rawIR > 1000) {
        // Serial USB
        Serial.print("{\"p\":"); Serial.print(rawIR); Serial.println("}");
        // BLE notify
        sendBLEppg((long)rawIR);
      }
    }

    // FIX HR: ngưỡng 40-150
    if (fingerDetected && checkForBeat(rawIR)) {
      long delta = millis() - lastBeat;
      lastBeat   = millis();
      beatsPerMinute = 60.0f / (delta / 1000.0f);
      if (beatsPerMinute > 40 && beatsPerMinute < 150) {
        rates[rateSpot++] = (byte)beatsPerMinute;
        rateSpot %= RATE_SIZE;
        beatAvg = 0;
        for (byte x = 0; x < RATE_SIZE; x++) beatAvg += rates[x];
        beatAvg /= RATE_SIZE;
      }
    }
  }

  // ── Tính SpO2 ────────────────────────────────
  maxim_heart_rate_and_oxygen_saturation(
    irBuffer, 100, redBuffer,
    &spo2, &validSPO2, &heartRate_mx, &validHR_mx);

  // FIX HR filter
  int rawHR  = (beatAvg > 0) ? beatAvg : (validHR_mx ? heartRate_mx : 0);
  int outHR  = (rawHR >= 40 && rawHR <= 180) ? rawHR : 0;

  // FIX SpO2 filter
 // FIX SpO2 filter
  int outSpO2 = 0;
  if (validSPO2 && spo2 >= 70 && spo2 <= 100) outSpO2 = spo2;

  long outPPG = (long)irBuffer[99];

  // ── Drift filter HR & SpO2 ───────────────────────
  if (!fingerDetected) {
    displayHR        = 0;
    displaySPO2      = 0;
    hrInited         = false;
    spo2Inited       = false;
    spo2DriftSamples = 0;
  } else {
    // ── HR ────────────────────────────────────────
    if (outHR > 0) {
      if (!hrInited) {
        displayHR = outHR;
        hrInited  = true;
      } else if (outHR >= 60 && outHR <= 100) {
        // Giữ nguyên
      } else if (outHR > 100) {
        displayHR++;
      } else {
        if (displayHR > 0) displayHR--;
      }
      displayHR = constrain(displayHR, 0, 250);
    }
    // ── SpO2 ──────────────────────────────────────
    if (outSpO2 > 0) {
      if (!spo2Inited) {
        displaySPO2 = outSpO2;
        spo2Inited  = true;
      } else if (outSpO2 >= 94 && outSpO2 <= 100) {
        // Giữ nguyên
      } else {
        spo2DriftSamples++;
        if (spo2DriftSamples >= 2) {
          spo2DriftSamples = 0;
          if (displaySPO2 > 0) displaySPO2--;
        }
      }
      displaySPO2 = constrain(displaySPO2, 0, 100);
    }
  }
  // ── Update TFT 250ms ─────────────────────────
 if (millis() - lastDraw >= 250) {
  lastDraw = millis();

  // Nhiệt độ luôn hiển thị, bất kể có ngón tay hay không
  updateTemp(tempC);
  updateTempLabel(tempMeasuring);

  if (!fingerDetected) {
    showNoFinger();
    updateStatus("Dat ngon tay len cam bien", 0);
  } else {
    prevFinger = true;
      updateHR(displayHR);
      updateSpO2(displaySPO2);
    drawWave();

      if (displaySPO2 > 0 && displaySPO2 < 90)
        updateStatus("!! SpO2 NGUY HIEM !!",       2);
      else if (mlxOK && tempC >= 38.3f && displayHR > 100)
        updateStatus("!! SEPSIS RISK !!",           2);
      else if (mlxOK && tempC >= 38.3f)
        updateStatus("!! SOT CAO - FEVER !!",       1);
      else if (displayHR > 130)
        updateStatus("!! NHIP TIM NHANH !!",        1);
      else if (displayHR > 0 && displayHR < 50)
        updateStatus("!! NHIP TIM CHAM !!",         1);
      else if (displaySPO2 > 0 && displaySPO2 < 94)
        updateStatus("SpO2 THAP - Can theo doi",    1);
      else if (displayHR >= 50 && displaySPO2 >= 94)
        updateStatus("BINH THUONG  :)",             0);
      else
        updateStatus("Dang do...",                  0);
    }
  }

  // ── JSON đầy đủ 1s — Serial + BLE ───────────
  if (millis() - lastReport >= REPORT_MS) {
    lastReport = millis();
    float safeTemp = (isnan(tempC) || isinf(tempC)) ? 0.0f : tempC;

    // Serial USB
    Serial.print("{");
    Serial.print("\"finger\":"); Serial.print(fingerDetected ? "true" : "false");
    Serial.print(",\"hr\":");    Serial.print(outHR);
    Serial.print(",\"spo2\":"); Serial.print(outSpO2);
    Serial.print(",\"temp\":"); Serial.print(safeTemp, 1);
    Serial.print(",\"ppg\":");  Serial.print(outPPG);
    Serial.print(",\"ble\":");  Serial.print(bleConnected ? "true" : "false");
    Serial.println("}");

    // BLE notify JSON đầy đủ
    sendBLE(displayHR, displaySPO2, safeTemp, outPPG, fingerDetected);

    if (!fingerDetected) {
      beatAvg = 0; beatsPerMinute = 0; rateSpot = 0;
      memset(rates,      0, sizeof(rates));
      memset(waveBuffer, 0, sizeof(waveBuffer));
    }
  }
}
