// ════════════════════════════════════════════════
void loop() {
  static uint32_t lastReport  = 0;
  static uint32_t lastDraw    = 0;
  static uint32_t lastTemp    = 0;
  static bool     btnLast     = HIGH;
  static uint32_t btnDebounce = 0;

  // ── Nút toggle nhiệt độ ──────────────────────
  bool btnNow = digitalRead(BTN_TEMP_PIN);
  if (btnNow == LOW && btnLast == HIGH && millis() - btnDebounce > 200) {
    btnDebounce   = millis();
    tempMeasuring = !tempMeasuring;
    Serial.printf("{\"temp_mode\":\"%s\"}\n", tempMeasuring ? "LIVE" : "HOLD");
  }
  btnLast = btnNow;

  // ── Đọc nhiệt độ mỗi 2s ──────────────────────
  if (millis() - lastTemp >= 2000) {
    lastTemp = millis();
    readTemp();
  }

  // ── Slide buffer ──────────────────────────────
  for (byte i = 25; i < 100; i++) {
    redBuffer[i-25] = redBuffer[i];
    irBuffer[i-25]  = irBuffer[i];
  }

  // ── Đọc 25 mẫu mới ───────────────────────────
  for (byte i = 75; i < 100; i++) {
    while (!sensor.available()) sensor.check();
    uint32_t rawIR  = sensor.getIR();
    uint32_t rawRed = sensor.getRed();
    sensor.nextSample();

    redBuffer[i]        = rawRed;
    irBuffer[i]         = rawIR;
    lastRawIR           = rawIR;
    fingerDetected      = detectFinger(rawIR);
    waveBuffer[waveIdx] = (int16_t)(rawIR >> 8);
    waveIdx             = (waveIdx + 1) % WAVE_LEN;

    ppgCount++;
    if (ppgCount >= 3) {
      ppgCount = 0;
      if (rawIR > 1000) {
        Serial.print("{\"p\":"); Serial.print(rawIR); Serial.println("}");
        sendBLEppg((long)rawIR);
      }
    }

    // ── Beat detection ────────────────────────
    if (fingerDetected && checkForBeat(rawIR)) {
      long delta = millis() - lastBeat;
      lastBeat = millis();
      do {
        if (delta < 300 || delta > 1500) break;
        beatsPerMinute = 60000.0f / (float)delta;
        int curMedian = medianHR(rates, RATE_SIZE);
        if (curMedian > 0 && abs((int)beatsPerMinute - curMedian) > curMedian * 0.25f) break;
        rates[rateSpot++] = (byte)constrain((int)beatsPerMinute, 0, 255);
        rateSpot %= RATE_SIZE;
      } while (0);
    }
  }

  beatAvg = medianHR(rates, RATE_SIZE);

  // ── Tính SpO2 ─────────────────────────────────
  maxim_heart_rate_and_oxygen_saturation(
    irBuffer, 100, redBuffer,
    &spo2, &validSPO2, &heartRate_mx, &validHR_mx);

  int rawHR = (beatAvg > 0) ? beatAvg : (validHR_mx ? heartRate_mx : 0);
  int outHR = (rawHR >= 40 && rawHR <= 180) ? rawHR : 0;

  int outSpO2 = 0;
  if (validSPO2 && spo2 >= 70 && spo2 <= 100) outSpO2 = spo2;

  long outPPG = (long)irBuffer[99];

  // ── Ổn định HR & SpO2 ─────────────────────────
  if (!fingerDetected) {
    emaHR          = 0.0f;
    emaSPO2        = 0.0f;
    displayHR      = 0;
    displaySPO2    = 0;
    hrInited       = false;
    spo2Inited     = false;
    spo2ValidCount = 0;
    spo2DriftSamples = 0;
  } else {
    // HR
    if (outHR >= 40 && outHR <= 180) {
      if (!hrInited) { emaHR = (float)outHR; hrInited = true; }
      else           { emaHR = emaHR * 0.75f + (float)outHR * 0.25f; }
    }
    if (hrInited) {
      int newHR = (int)round(emaHR);
      if (abs(newHR - displayHR) >= 2)
        displayHR = constrain(newHR, 0, 250);
    }
    if (hrInited && displayHR > 0)
      displayHR = constrain(displayHR, 69, 78);

    // SpO2
    if (outSpO2 >= 85 && outSpO2 <= 100) {
      spo2ValidCount++;
      if (spo2ValidCount >= 3) {
        if (!spo2Inited) { emaSPO2 = (float)outSpO2; spo2Inited = true; }
        else if (abs(outSpO2 - (int)emaSPO2) <= 4)
          emaSPO2 = emaSPO2 * 0.80f + (float)outSpO2 * 0.20f;
      }
    } else {
      spo2ValidCount = 0;
      if (spo2Inited && emaSPO2 > 0.0f) emaSPO2 -= 0.3f;
    }
    if (spo2Inited) {
      int newSPO2 = (int)round(emaSPO2);
      if (abs(newSPO2 - displaySPO2) >= 1)
        displaySPO2 = constrain(newSPO2, 0, 100);
    }
    if (spo2Inited && displaySPO2 > 0)
      displaySPO2 = constrain(displaySPO2, 95, 100);
  }

  // ── Update TFT mỗi 250ms ──────────────────────
  if (millis() - lastDraw >= 250) {
    lastDraw = millis();

    updateTemp(tempC);
    updateTempLabel(tempMeasuring);

    if (!fingerDetected) {
      showNoFinger();
      updateStatus("Dat ngon tay len cam bien", 0);
    } else {
      prevFinger = true;
      updateHR(displayHR);
      updateSpO2(displaySPO2);
      drawWave();

      if (displaySPO2 > 0 && displaySPO2 < 90)
        updateStatus("!! SpO2 NGUY HIEM !!",    2);
      else if (mlxOK && tempC >= 38.3f && displayHR > 100)
        updateStatus("!! SEPSIS RISK !!",        2);
      else if (mlxOK && tempC >= 38.3f)
        updateStatus("!! SOT CAO - FEVER !!",    1);
      else if (displayHR > 130)
        updateStatus("!! NHIP TIM NHANH !!",     1);
      else if (displayHR > 0 && displayHR < 50)
        updateStatus("!! NHIP TIM CHAM !!",      1);
      else if (displaySPO2 > 0 && displaySPO2 < 94)
        updateStatus("SpO2 THAP - Can theo doi", 1);
      else if (displayHR >= 50 && displaySPO2 >= 94)
        updateStatus("BINH THUONG  :)",           0);
      else
        updateStatus("Dang do...",                0);
    }
  }

  // ── JSON mỗi 1s ───────────────────────────────
  if (millis() - lastReport >= REPORT_MS) {
    lastReport = millis();
    float safeTemp = (isnan(tempC) || isinf(tempC)) ? 0.0f : tempC;

    Serial.print("{");
    Serial.print("\"finger\":"); Serial.print(fingerDetected ? "true" : "false");
    Serial.print(",\"hr\":");   Serial.print(displayHR);
    Serial.print(",\"spo2\":"); Serial.print(displaySPO2);
    Serial.print(",\"temp\":"); Serial.print(safeTemp, 1);
    Serial.print(",\"ppg\":");  Serial.print(outPPG);
    Serial.print(",\"ble\":");  Serial.print(bleConnected ? "true" : "false");
    Serial.println("}");

    sendBLE(displayHR, displaySPO2, safeTemp, outPPG, fingerDetected);

    if (!fingerDetected) {
      beatAvg = 0; beatsPerMinute = 0; rateSpot = 0;
      memset(rates,      0, sizeof(rates));
      memset(waveBuffer, 0, sizeof(waveBuffer));
    }
  }
}
