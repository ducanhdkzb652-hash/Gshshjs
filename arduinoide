// ════════════════════════════════════════════════
int medianHR(byte* arr, byte size) {
  byte sorted[RATE_SIZE];
  memcpy(sorted, arr, size);
  for (int i = 0; i < size - 1; i++)
    for (int j = 0; j < size - i - 1; j++)
      if (sorted[j] > sorted[j + 1]) {
        byte t = sorted[j];
        sorted[j] = sorted[j + 1];
        sorted[j + 1] = t;
      }
  return sorted[size / 2];
}

// ════════════════════════════════════════════════
class BLEServerCB : public BLEServerCallbacks {
  void onConnect(BLEServer* s) override {
    bleConnected = true;
    Serial.println("{\"event\":\"BLE_CONNECTED\"}");
    tft.fillRect(270, 4, 44, 12, C_HEADER);
    tft.setTextColor(C_GREEN);
    tft.setTextSize(1);
    tft.setCursor(272, 7);
    tft.print("BLE:ON");
  }
  void onDisconnect(BLEServer* s) override {
    bleConnected = false;
    Serial.println("{\"event\":\"BLE_DISCONNECTED\"}");
    tft.fillRect(270, 4, 44, 12, C_HEADER);
    tft.setTextColor(C_GRAY);
    tft.setTextSize(1);
    tft.setCursor(272, 7);
    tft.print("BLE:--");
    BLEDevice::startAdvertising();
  }
};

// ════════════════════════════════════════════════
void setupBLE() {
  BLEDevice::init(BLE_DEVICE_NAME);
  BLEDevice::setPower(ESP_PWR_LVL_P3);
  bleServer = BLEDevice::createServer();
  bleServer->setCallbacks(new BLEServerCB());
  BLEService* svc = bleServer->createService(BLE_SERVICE_UUID);
  bleChar = svc->createCharacteristic(
    BLE_CHAR_UUID,
    BLECharacteristic::PROPERTY_READ |
    BLECharacteristic::PROPERTY_NOTIFY
  );
  bleChar->addDescriptor(new BLE2902());
  svc->start();
  BLEAdvertising* adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(BLE_SERVICE_UUID);
  adv->setScanResponse(true);
  adv->setMinPreferred(0x06);
  adv->setMaxPreferred(0x12);
  BLEDevice::startAdvertising();
  Serial.println("{\"event\":\"BLE_STARTED\"}");
}

// ════════════════════════════════════════════════
void sendBLE(int hr, int sp, float temp, long ppg, bool finger) {
  if (!bleConnected || bleChar == nullptr) return;
  String json = "{";
  json += "\"finger\":" + String(finger ? "true" : "false") + ",";
  json += "\"hr\":"     + String(hr)      + ",";
  json += "\"spo2\":"   + String(sp)      + ",";
  json += "\"temp\":"   + String(temp, 1) + ",";
  json += "\"ppg\":"    + String(ppg);
  json += "}";
  bleChar->setValue(json.c_str());
  bleChar->notify();
}

void sendBLEppg(long ppg) {
  if (!bleConnected || bleChar == nullptr) return;
  String json = "{\"p\":" + String(ppg) + "}";
  bleChar->setValue(json.c_str());
  bleChar->notify();
}

