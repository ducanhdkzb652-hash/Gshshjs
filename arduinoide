// ════════════════════════════════════════════════
void drawWave() {
  if (!fingerDetected) return;
  int16_t wMin = waveBuffer[0], wMax = waveBuffer[0];
  for (int i = 1; i < WAVE_LEN; i++) {
    wMin = min(wMin, waveBuffer[i]);
    wMax = max(wMax, waveBuffer[i]);
  }
  if (wMax == wMin) wMax = wMin + 1;
  for (int i = 1; i < WAVE_LEN; i++) {
    int xi = map(i,     0, WAVE_LEN-1, WAVE_X, WAVE_X+WAVE_W-1);
    int xp = map(i - 1, 0, WAVE_LEN-1, WAVE_X, WAVE_X+WAVE_W-1);
    int yi = map(waveBuffer[(waveIdx+i)   % WAVE_LEN], wMin, wMax, WAVE_Y+WAVE_H-2, WAVE_Y+2);
    int yp = map(waveBuffer[(waveIdx+i-1) % WAVE_LEN], wMin, wMax, WAVE_Y+WAVE_H-2, WAVE_Y+2);
    if (waveInited)
      tft.drawLine(xp, prevWY[i-1], xi, prevWY[i], C_BG);
    tft.drawLine(xp, yp, xi, yi, C_WAVE);
    prevWY[i-1] = yp;
    prevWY[i]   = yi;
  }
  waveInited = true;
}

// ════════════════════════════════════════════════
bool detectFinger(uint32_t ir) {
  if (ir > IR_FINGER_THRESHOLD) {
    if (++goodCount >= FINGER_CONFIRM_COUNT) return true;
  } else {
    goodCount = 0;
  }
  return false;
}

void fillBuffer() {
  for (byte i = 0; i < 100; i++) {
    while (!sensor.available()) sensor.check();
    redBuffer[i] = sensor.getRed();
    irBuffer[i]  = sensor.getIR();
    sensor.nextSample();
  }
  maxim_heart_rate_and_oxygen_saturation(
    irBuffer, 100, redBuffer,
    &spo2, &validSPO2, &heartRate_mx, &validHR_mx);
}

// ════════════════════════════════════════════════
void readTemp() {
  if (!mlxOK || !tempMeasuring) return;
  float obj = mlx.readObjectTempC();
  float amb = mlx.readAmbientTempC();
  Serial.printf("[TEMP] obj=%.2f  amb=%.2f\n", obj, amb);
  if (isnan(obj) || isinf(obj) || isnan(amb) || isinf(amb)) return;
  if (obj < 0 || obj > 100 || amb < 0 || amb > 60) return;

  float newTemp = 0.0f;
  if (obj > 45.0f) {
    newTemp = obj;
    Serial.printf("[TEMP] mode=RAW_HIGH val=%.2f\n", newTemp);
  } else if (obj > amb) {
    float ratio = (obj - amb) / (45.0f - amb);
    newTemp = constrain(36.0f + ratio * 1.0f, 36.0f, 37.0f);
    Serial.printf("[TEMP] mode=NORM raw=%.2f norm=%.2f\n", obj, newTemp);
  } else {
    newTemp = obj;
    Serial.printf("[TEMP] mode=RAW_LOW val=%.2f\n", newTemp);
  }

  float alpha = (obj > 45.0f) ? 0.5f : 0.3f;
  tempC = tempC * (1.0f - alpha) + newTemp * alpha;
}

